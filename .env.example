# Copy to .env.local for development, and set the same names in Vercel's project settings.

# Supabase: database, login and thumbnails. Public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The site's own address, used in password-reset emails.
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2: video files. Secret. Never give these names a NEXT_PUBLIC_ prefix.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare Workers AI, on the same account as R2: automatic subtitles. Secret. Optional: without it the feature hides itself.
# A token with the "Workers AI: Read" and "Workers AI: Edit" permissions.
CLOUDFLARE_AI_TOKEN=
